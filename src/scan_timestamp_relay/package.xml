<?xml version="1.0"?>
<package format="3">
  <name>scan_timestamp_relay</name>
  <version>0.1.0</version>
  <description>Republishes LaserScan data with a timestamp in the local ROS clock domain.</description>
  <maintainer email="noreply@example.com">ROS Workspace</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>slam_gmapping</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
